# Stage 1: Build the Nuxt application
FROM node:22-alpine AS build

WORKDIR /app

# Build arguments passed from docker-compose
ARG NUXT_PUBLIC_API_BASE_URL
ARG FIREBASE_API_KEY
ARG FIREBASE_AUTH_DOMAIN
ARG GCP_PROJECT_ID
ARG FIREBASE_STORAGE_BUCKET
ARG FIREBASE_MESSAGING_SENDER_ID
ARG FIREBASE_APP_ID
ARG CLOUDFLARE_TURNSTILE_SITE_KEY

# Set environment variables for Nuxt compiler
ENV NUXT_PUBLIC_API_BASE_URL=$NUXT_PUBLIC_API_BASE_URL
ENV FIREBASE_API_KEY=$FIREBASE_API_KEY
ENV FIREBASE_AUTH_DOMAIN=$FIREBASE_AUTH_DOMAIN
ENV FIREBASE_PROJECT_ID=$GCP_PROJECT_ID
ENV FIREBASE_STORAGE_BUCKET=$FIREBASE_STORAGE_BUCKET
ENV FIREBASE_MESSAGING_SENDER_ID=$FIREBASE_MESSAGING_SENDER_ID
ENV FIREBASE_APP_ID=$FIREBASE_APP_ID
ENV CLOUDFLARE_TURNSTILE_SITE_KEY=$CLOUDFLARE_TURNSTILE_SITE_KEY

# Also expose NUXT_PUBLIC aliases in case runtime config references them
ENV NUXT_PUBLIC_FIREBASE_API_KEY=$FIREBASE_API_KEY
ENV NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$FIREBASE_AUTH_DOMAIN
ENV NUXT_PUBLIC_FIREBASE_PROJECT_ID=$GCP_PROJECT_ID
ENV NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=$FIREBASE_STORAGE_BUCKET
ENV NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=$FIREBASE_MESSAGING_SENDER_ID
ENV NUXT_PUBLIC_FIREBASE_APP_ID=$FIREBASE_APP_ID
ENV NUXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=$CLOUDFLARE_TURNSTILE_SITE_KEY

# Copy dependency files
COPY package.json pnpm-lock.yaml* ./

# Install pnpm v9
RUN npm install -g pnpm@9

# Install dependencies
RUN pnpm install --ignore-scripts

# Copy application source code
COPY . .

# Prepare and generate static files
RUN npx nuxt prepare && npx nuxt generate

# Stage 2: Serve the application with Nginx
FROM nginx:stable-alpine AS production

COPY --from=build /app/.output/public /usr/share/nginx/html
COPY ./nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
